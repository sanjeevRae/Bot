# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Backend API (your Render URL) ----
# Primary backend; NEXT_PUBLIC_API_FALLBACK_URL is tried automatically when
# the primary is down (closed, asleep, 502/503/504, or hanging).
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_FALLBACK_URL=
# Optional cap (ms) on the primary attempt when a fallback is set (default 20000)
# NEXT_PUBLIC_API_TIMEOUT_MS=20000
