# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Groq (https://console.groq.com/keys) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# ---- OpenRouter fallback (https://openrouter.ai/keys) ----
# Used automatically when Groq fails or rate-limits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Embeddings (optional; https://huggingface.co/settings/tokens) ----
# Without a token, a local fallback embedder is used automatically.
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- CORS: your Vercel frontend URL(s), comma-separated. * allows all (dev only) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Public URL of this backend (used in widget.js / bot pages / keep-alive) ----
PUBLIC_BACKEND_URL=http://localhost:5000

# ---- Keep-alive: prevents Render free tier from sleeping ----
# On by default in production. Pings /health every 14 minutes.
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MS=840000

# ---- Free-tier quotas ----
# Messages are a ONE-TIME allowance (never reset) — not a monthly quota.
QUOTA_MESSAGES_TOTAL=100
QUOTA_DOCUMENTS_MAX=10
QUOTA_BOOKINGS_PER_MONTH=50

# ---- Chat latency tuning (see backend/bench-chat.js + bench-http.js) ----
# Context chars injected per reply (lower = faster first token)
MAX_CONTEXT_CHARS=6000
# Prior messages replayed to the model
CHAT_HISTORY_TURNS=4
# Generated-token caps per surface (answer length drives generation time)
LLM_MAX_TOKENS_WEB=600
LLM_MAX_TOKENS_CHANNEL=450
# Per-call deadline and 429 handling
LLM_TIMEOUT_MS=15000
LLM_RETRY_MAX_WAIT_MS=1500
LLM_FALLBACK_TIMEOUT_MS=12000
# Embedding fail-fast (HuggingFace) and small-corpus fast path
EMBED_TIMEOUT_MS=2500
RAG_SMALL_CORPUS_MAX=120
RAG_SMALL_CORPUS_TOP_K=6

# ---- Rate limiting ----
RATE_LIMIT_PER_HOUR=300
CHAT_RATE_LIMIT_PER_MIN=20

# ============================================================
# V10 — Knowledge-base ingest (documents, OCR, voice notes, video)
# ============================================================
# Supported uploads: PDF, DOCX, XLSX, PPTX, TXT, MD, CSV, JSON,
# menu/price-list photos (OCR) and voice notes (Whisper).
#
# OCR for images — free key, no card: https://ocr.space/ocrapi
# Leave empty to fall back to the Groq vision model (uses GROQ_API_KEY).
OCR_SPACE_API_KEY=
# OCR language codes, joined with '+' (eng, eng+nep, ...)
OCR_LANGUAGE=eng
# Upload ceilings, in bytes. Audio goes to Groq Whisper (provider cap ~25 MB).
KB_MAX_FILE_BYTES=5242880
KB_MAX_AUDIO_BYTES=20971520
# Third-party ingest deadlines
OCR_TIMEOUT_MS=25000
OCR_VISION_TIMEOUT_MS=25000
TRANSCRIBE_TIMEOUT_MS=90000
YOUTUBE_TIMEOUT_MS=20000
# Longest YouTube transcript to learn from (characters)
YOUTUBE_MAX_CHARS=20000
# OCR fallback model + Whisper model for voice notes
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_WHISPER_MODEL=whisper-large-v3

# ============================================================
# V2 — Messaging channels (Meta Cloud APIs)
# https://developers.facebook.com/apps → create app → add WhatsApp/Messenger
# ============================================================
META_GRAPH_VERSION=v20.0
META_VERIFY_TOKEN=any-secret-string-you-choose
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=

# ============================================================
# OpenWA — self-hosted WhatsApp gateway (external service)
# OpenWA runs on your own machine/Docker and is reached from Render via a
# Cloudflare Tunnel. Chitra reuses its existing RAG/Groq pipeline to answer
# inbound WhatsApp messages; replies are sent back through OpenWA.
# None of these are ever exposed to the frontend.
# ============================================================
# Local dev: http://localhost:2785  |  Production: https://wa.<your-domain>
OPENWA_BASE_URL=
# The OpenWA API key (X-API-Key header) — server-only, never commit
OPENWA_API_KEY=
# Alphanumeric value >= 16 chars. Used to sign OpenWA webhook deliveries (HMAC-SHA256).
OPENWA_WEBHOOK_SECRET=

# ============================================================
# V3 — Email notifications + Turnstile captcha
# ============================================================
# ---- Email notifications (pick ONE provider; Brevo wins if both are set) ----
# Brevo (https://brevo.com) — SAME provider you configured in Supabase SMTP.
# Get the API key: Brevo dashboard → SMTP & API → API Keys → Create a new key.
# NOTE: the SMTP key you pasted into Supabase is NOT the API key — create an
# API key here; the sender address must already be a verified sender in Brevo.
BREVO_API_KEY=

# Resend (https://resend.com) — free 100 emails/day; only used if BREVO_API_KEY
# is empty. Powers agency client invites + booking/lead/handoff alerts.
# Without either key, notifications are silently skipped.
RESEND_API_KEY=

# Sender shown on outgoing alerts. With Brevo, use an address you verified in
# Brevo (e.g. alerts@yourdomain.com). Supabase's onboarding@resend.dev sender
# only works with Resend.
EMAIL_FROM=Chitra AI <alerts@chitratech.com.np>


# ---- Chat session isolation (REQUIRED in production) ----
# Signs the HMAC token that binds each visitor chat session to its organization,
# so one visitor can never read or continue another visitor's conversation.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Leave empty to disable captcha (dev mode).
TURNSTILE_SECRET_KEY=

# ============================================================
# V4 — Nepali payments (eSewa + Khalti)
# Sandbox works out of the box. Swap URLs/keys for production.
# ============================================================
PUBLIC_FRONTEND_URL=http://localhost:3000

# eSewa: sandbox = rc-epay.esewa.com.np + EPAYTEST; prod = epay.esewa.com.np
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_SUCCESS_URL=http://localhost:5000/api/billing/esewa/verify
ESEWA_FAILURE_URL=http://localhost:3000/billing?status=failed

# Khalti: sandbox = a.khalti.com/api/v2; prod = khalti.com/api/v2
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_SECRET_KEY=

# ============================================================
# V11 — Channel reliability, handoff, broadcasts, Telegram/Viber
# ============================================================
# Inbound media (voice notes / photos) budgets per message:
CHANNEL_VOICE_MAX_BYTES=3145728
CHANNEL_IMAGE_MAX_BYTES=2097152
CHANNEL_MEDIA_FETCH_TIMEOUT_MS=20000
CHANNEL_MEDIA_STT_TIMEOUT_MS=45000
CHANNEL_MEDIA_OCR_TIMEOUT_MS=30000
# Long replies are split (not truncated): numbered parts at sentence bounds
CHANNEL_MAX_SPLIT_PARTS=4
# Broadcasts: in-process sweeper + pacing + per-sweep cap
BROADCAST_SWEEP_MS=60000
BROADCAST_PER_MINUTE=10
BROADCAST_MAX_PER_SWEEP=300
# SMS fallback (Sparrow or any generic gateway) — outbound only, paid plans
# SMS_MODE: 'sparrow' (token+from+to+text) or 'generic' (Bearer + {to,text})
SMS_API_URL=
SMS_API_KEY=
SMS_MODE=generic
SMS_SENDER_ID=ChitraAI
SMS_TIMEOUT_MS=10000

# ---- Keep-alive ----
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MS=840000
# External pinger to wake a sleeping Render free instance (cron-job.org / UptimeRobot)
KEEP_ALIVE_CRON_URL=

