# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Groq (https://console.groq.com/keys) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# ---- OpenRouter fallback (https://openrouter.ai/keys) ----
# Used automatically when Groq fails or rate-limits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Embeddings (optional; https://huggingface.co/settings/tokens) ----
# Without a token, a local fallback embedder is used automatically.
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- CORS: your Vercel frontend URL(s), comma-separated. * allows all (dev only) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Public URL of this backend (used in widget.js / bot pages / keep-alive) ----
PUBLIC_BACKEND_URL=http://localhost:5000

# ---- Keep-alive: prevents Render free tier from sleeping ----
# On by default in production. Pings /health every 14 minutes.
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MS=840000

# ---- Free-tier quotas ----
QUOTA_MESSAGES_PER_MONTH=100
QUOTA_DOCUMENTS_MAX=10
QUOTA_BOOKINGS_PER_MONTH=50

# ---- Rate limiting ----
RATE_LIMIT_PER_HOUR=300
CHAT_RATE_LIMIT_PER_MIN=20

# ============================================================
# V2 — Messaging channels (Meta Cloud APIs)
# https://developers.facebook.com/apps → create app → add WhatsApp/Messenger
# ============================================================
META_GRAPH_VERSION=v20.0
META_VERIFY_TOKEN=any-secret-string-you-choose
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=

# ============================================================
# V3 — Email notifications + Turnstile captcha
# ============================================================
# Resend (https://resend.com) — free 100 emails/day, no card
RESEND_API_KEY=
EMAIL_FROM=Chitra AI <onboarding@resend.dev>

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Leave empty to disable captcha (dev mode).
TURNSTILE_SECRET_KEY=

# ============================================================
# V4 — Nepali payments (eSewa + Khalti)
# Sandbox works out of the box. Swap URLs/keys for production.
# ============================================================
PUBLIC_FRONTEND_URL=http://localhost:3000

# eSewa: sandbox = rc-epay.esewa.com.np + EPAYTEST; prod = epay.esewa.com.np
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_SUCCESS_URL=http://localhost:5000/api/billing/esewa/verify
ESEWA_FAILURE_URL=http://localhost:3000/billing?status=failed

# Khalti: sandbox = a.khalti.com/api/v2; prod = khalti.com/api/v2
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_SECRET_KEY=

# ---- Keep-alive ----
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MS=840000
# External pinger to wake a sleeping Render free instance (cron-job.org / UptimeRobot)
KEEP_ALIVE_CRON_URL=

